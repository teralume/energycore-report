@startuml
title EnergyCore PostgreSQL - Billing, Notifications, Reporting and Service ERD
hide methods
hide stereotypes
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

entity USERS {
  * id : BIGSERIAL <<PK>>
}
entity DEVICES {
  * id : BIGSERIAL <<PK>>
}
entity PLANS {
  * id : BIGSERIAL <<PK>>
  --
  code : VARCHAR(40) <<UQ>>
  name : VARCHAR(80)
  monthly_price_amount : NUMERIC(10,2)
  monthly_price_currency : VARCHAR(10)
  max_devices : INTEGER
  max_routines : INTEGER
  max_alerts : INTEGER
}
entity SUBSCRIPTIONS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  plan_id : BIGINT <<FK>>
  status : VARCHAR(30)
  start_date : DATE
  end_date : DATE
}
entity PAYMENTS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  subscription_id : BIGINT <<FK>>
  amount : NUMERIC(10,2)
  currency : VARCHAR(10)
  status : VARCHAR(30)
  payment_method : VARCHAR(50)
  paid_at : TIMESTAMP
}
entity INVOICES {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  payment_id : BIGINT <<FK>>
  invoice_number : VARCHAR(80) <<UQ>>
  total_amount : NUMERIC(10,2)
  currency : VARCHAR(10)
  issued_at : DATE
}
entity ALERT_RULE_PROFILES {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  name : VARCHAR(120)
  scope_type : VARCHAR(30)
  scope_id : VARCHAR(80)
  mode : VARCHAR(30)
  sensitivity : VARCHAR(30)
  active : BOOLEAN
}
entity ALERT_RULES {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  name : VARCHAR(120)
  metric : VARCHAR(60)
  condition_type : VARCHAR(40)
  threshold : NUMERIC(10,2)
  level : VARCHAR(30)
  scope_type : VARCHAR(40)
  scope_id : VARCHAR(80)
  enabled : BOOLEAN
}
entity ALERTS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  title : VARCHAR(160)
  message : TEXT
  level : VARCHAR(30)
  source_type : VARCHAR(30)
  source_id : VARCHAR(80)
  event_type : VARCHAR(40)
  resolved : BOOLEAN
  read_status : BOOLEAN
}
entity NOTIFICATION_PREFERENCES {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK,UQ>>
  scope_type : VARCHAR(30)
  scope_id : VARCHAR(80)
  email_enabled : BOOLEAN
  push_enabled : BOOLEAN
  minimum_level : VARCHAR(30)
  cooldown_minutes : INTEGER
}
entity ENERGY_GOALS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  title : VARCHAR(160)
  target_watts : NUMERIC(12,6)
  current_watts : NUMERIC(12,6)
  deadline : DATE
  status : VARCHAR(40)
  scope_type : VARCHAR(20)
  scope_id : BIGINT
}
entity CONSUMPTION_REPORTS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  total_watts : NUMERIC(12,2)
  average_watts : NUMERIC(12,2)
  highest_watts : NUMERIC(12,2)
  start_date : DATE
  end_date : DATE
}
entity REPORTING_EVENTS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  event_key : VARCHAR(240) <<UQ>>
  event_name : VARCHAR(120)
  source_context : VARCHAR(80)
  subject_type : VARCHAR(80)
  subject_id : VARCHAR(80)
  occurred_on : TIMESTAMP
}
entity SUPPORT_TICKETS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  subject : VARCHAR(160)
  description : TEXT
  priority : VARCHAR(40)
  status : VARCHAR(40)
}
entity MAINTENANCE_TICKETS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  device_id : BIGINT <<LFK>>
  device_name : VARCHAR(120)
  type : VARCHAR(60)
  description : TEXT
  scheduled_date : DATE
  status : VARCHAR(40)
}

USERS ||..o{ SUBSCRIPTIONS : logical FK
PLANS ||--o{ SUBSCRIPTIONS : physical FK
SUBSCRIPTIONS ||--o{ PAYMENTS : physical FK
USERS ||..o{ PAYMENTS : logical FK
PAYMENTS ||--o| INVOICES : physical FK
USERS ||..o{ INVOICES : logical FK
USERS ||..o{ ALERT_RULE_PROFILES : logical FK
USERS ||..o{ ALERT_RULES : logical FK
USERS ||..o{ ALERTS : logical FK
USERS ||..o| NOTIFICATION_PREFERENCES : logical FK
USERS ||..o{ ENERGY_GOALS : logical FK
USERS ||..o{ CONSUMPTION_REPORTS : logical FK
USERS ||..o{ REPORTING_EVENTS : logical FK
USERS ||..o{ SUPPORT_TICKETS : logical FK
USERS ||..o{ MAINTENANCE_TICKETS : logical FK
DEVICES ||..o{ MAINTENANCE_TICKETS : logical FK

legend bottom
  |= Marker |= Meaning |
  | PK | primary key inherited from AuditableEntity |
  | FK | database-enforced JPA association |
  | LFK | logical foreign key stored as Long; application-enforced |
endlegend
@enduml
