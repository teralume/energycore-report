@startuml
title EnergyCore PostgreSQL - Billing ERD
left to right direction
hide methods
hide stereotypes
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

entity USERS {
  * id : BIGSERIAL <<PK>>
}
entity PLANS {
  * id : BIGSERIAL <<PK>>
  --
  code : VARCHAR(40) <<UQ>>
  name : VARCHAR(80)
  monthly_price_amount : NUMERIC(10,2)
  monthly_price_currency : VARCHAR(10)
  max_devices : INTEGER
  max_routines : INTEGER
  max_alerts : INTEGER
}
entity SUBSCRIPTIONS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  plan_id : BIGINT <<FK>>
  status : VARCHAR(30)
  start_date : DATE
  end_date : DATE
}
entity PAYMENTS {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  subscription_id : BIGINT <<FK>>
  amount : NUMERIC(10,2)
  currency : VARCHAR(10)
  status : VARCHAR(30)
  payment_method : VARCHAR(50)
  paid_at : TIMESTAMP
}
entity INVOICES {
  * id : BIGSERIAL <<PK>>
  --
  user_id : BIGINT <<LFK>>
  payment_id : BIGINT <<FK>>
  invoice_number : VARCHAR(80) <<UQ>>
  total_amount : NUMERIC(10,2)
  currency : VARCHAR(10)
  issued_at : DATE
}

USERS ||..o{ SUBSCRIPTIONS : logical FK
PLANS ||--o{ SUBSCRIPTIONS : physical FK
SUBSCRIPTIONS ||--o{ PAYMENTS : physical FK
USERS ||..o{ PAYMENTS : logical FK
PAYMENTS ||--o| INVOICES : physical FK
USERS ||..o{ INVOICES : logical FK

legend bottom
  |= Marker |= Meaning |
  | PK | primary key inherited from AuditableEntity |
  | FK | database-enforced JPA association |
  | LFK | logical foreign key stored as Long; application-enforced |
endlegend
@enduml
